PORT=3000
SESSION_SECRET=change-this-secret-to-something-secure
# Путь к директории с данными (БД, ключ шифрования, файлы записей)
DATA_DIR=data
# Внешний URL сервиса, если он за reverse-proxy. По умолчанию определяется автоматически.
BASE_URL=
# Ключ шифрования AES-256 в hex (32 байта). Если пусто — генерируется и хранится в data/secret.key
ENCRYPTION_KEY=